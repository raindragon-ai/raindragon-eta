{
  "manifest_version": 3,
  "name": "RainDragon Forecast",
  "version": "0.2.0",
  "description": "Shows how long replies on claude.ai, chatgpt.com and gemini.google.com usually take you, as a range from your own past replies.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://status.claude.com/*",
    "https://status.openai.com/*",
    "https://www.google.com/appsstatus/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "lib/predict.js",
        "lib/pill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/chatgpt_sse.js",
        "chatgpt_tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/predict.js",
        "lib/pill.js",
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "lib/predict.js",
        "lib/pill.js",
        "lib/gemini_dom.js",
        "gemini.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "short_name": "RainDragon Forecast",
  "homepage_url": "https://github.com/raindragon-ai/raindragon-forecast",
  "web_accessible_resources": [
    {
      "resources": [
        "icons/32.png",
        "icons/mark.png"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ]
}
