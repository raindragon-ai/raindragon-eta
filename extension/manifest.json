{
  "manifest_version": 3,
  "name": "RainDragon ETA",
  "version": "0.2.0",
  "description": "How long replies like this one usually take you on claude.ai and chatgpt.com, as a range from your own history. Flags major Claude and ChatGPT incidents.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://status.claude.com/*",
    "https://status.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "lib/predict.js",
        "lib/pill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/chatgpt_sse.js",
        "chatgpt_tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/predict.js",
        "lib/pill.js",
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "short_name": "RainDragon ETA",
  "homepage_url": "https://github.com/raindragon-ai/raindragon-eta"
}
